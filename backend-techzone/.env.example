# ==============================================================
# TECHZONE - Backend - Plantilla de Variables de Entorno
#
# INSTRUCCIONES:
#   1. Copiar este archivo y renombrarlo como .env dentro de backend-techzone/
#   2. Asignar los valores correspondientes a cada clave
#   3. .env esta en .gitignore: nunca debe commitearse a control de versiones
# ==============================================================

# --- API RENIEC / DNI (https://apis.net.pe) ---
# Token Bearer para consulta y autocompletado de datos personales por DNI
DNI_API_TOKEN=

# --- Supabase Storage (Settings -> API) ---
# URL principal del proyecto en la nube Supabase
SUPABASE_URL=https://TU-REF.supabase.co
# Service Role Key con permisos administrativos para subir y eliminar imagenes en el bucket
SUPABASE_SERVICE_KEY=
# Nombre del bucket publico para almacenar imagenes de productos
SUPABASE_BUCKET=imagenes

# --- Supabase Base de Datos PostgreSQL (Settings -> Database) ---
# URL de conexion JDBC (utilizar Transaction Pooler puerto 6543 en redes IPv4)
SUPABASE_DB_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:6543/postgres
# Usuario de base de datos (lleva prefijo postgres.<ref-proyecto> en el pooler)
SUPABASE_DB_USER=postgres.TU-REF
# Contrasena de acceso a la base de datos PostgreSQL
SUPABASE_DB_PASSWORD=

# --- Seguridad y Autenticacion JWT ---
# Secreto criptografico HMAC-SHA256 (64+ caracteres) para firmar y validar tokens de sesion
JWT_SECRET=
