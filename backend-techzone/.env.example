# ==============================================================
#  TECHZONE · Backend · Plantilla de variables de entorno
#
#  COMO USARLO:
#    1. Copia este archivo y renombralo a  .env
#    2. Rellena cada valor con los tuyos
#    3. Arranca con   .\iniciar.ps1
#
#  .env esta en .gitignore  ->  NUNCA se sube a git.
#  Este .env.example SI se sube (va sin valores).
# ==============================================================

# --- API de consulta de DNI  (https://apis.net.pe) ---
# Cada desarrollador registra su cuenta y usa SU token.
DNI_API_TOKEN=

# --- Supabase · Proyecto  (Settings -> API) ---
SUPABASE_URL=https://TU-REF.supabase.co
SUPABASE_SERVICE_KEY=

# --- Supabase · Base de datos  (Settings -> Database -> Connection string) ---
SUPABASE_DB_URL=jdbc:postgresql://db.TU-REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_PASSWORD=

# --- Firma de los JWT ---
# Genera una cadena aleatoria de 64+ caracteres.
JWT_SECRET=
